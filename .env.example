# OpticalSense — environment (backend + shared)
# Copy to .env and fill in for Live Mode. Demo Mode ignores these.

# ── Mode ────────────────────────────────────────────
VITE_APP_NAME=OpticalSense
VITE_USE_MOCK=true

# ── Backend API (Node.js + Express, deployed on Render) ─
VITE_API_URL=
VITE_SOCKET_URL=
VITE_JWT_ISSUER=opticalsense

# ── MQTT (HiveMQ Cloud) ─────────────────────────────
VITE_MQTT_HOST=
VITE_MQTT_PORT=8883
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_TOPIC_PREFIX=opticalsense

# ── Backend-only (never exposed to browser) ─────────
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET=change-me
# JWT_REFRESH_SECRET=change-me
# PORT=4000
